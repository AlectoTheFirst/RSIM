{
  "name": "rsim-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The browser UI of rsim, served by rsim-api.",
  "license": "MIT",
  "scripts": {
    "api": "openapi-typescript ../crates/rsim-api/openapi.json --output src/api/schema.ts && node scripts/fields.mjs",
    "api:check": "openapi-typescript ../crates/rsim-api/openapi.json --check --output src/api/schema.ts && node scripts/fields.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
